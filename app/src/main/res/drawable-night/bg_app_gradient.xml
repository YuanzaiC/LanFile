<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#FF17122B"
                android:endColor="#FF0A1A1E"
                android:startColor="#FF0D1224"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:gravity="top|end"
        android:height="280dp"
        android:width="280dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="140dp"
                android:startColor="#4D3D5BD9"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:gravity="bottom|start"
        android:height="260dp"
        android:width="260dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="130dp"
                android:startColor="#3D2E7D74"
                android:type="radial" />
        </shape>
    </item>
</layer-list>